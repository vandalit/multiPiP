{
  "manifest_version": 3,
  "name": "Multi PiP (Experimental)",
  "version": "0.1.0",
  "description": "Spike de monitor PiP con dos slots fijos y fuentes de video de pestañas.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "Probar apertura de Multi PiP"
  }
}
